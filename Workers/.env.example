# AIDP workers — copy to .env and fill in.

# --- Which loop this container runs ----------------------------------------
# parse | chunk | embed. docker-compose sets this per service; only needed here
# when running a worker directly.
# STAGE=parse

# --- Database ---------------------------------------------------------------
# Neon's *direct* (non-pooled) string — the host WITHOUT "-pooler" in it.
# Workers hold interactive transactions for the length of a stage, and PgBouncer's
# transaction mode would break the lease semantics the queue depends on.
# The Next.js app is the opposite case and wants the pooled string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Model provider ----------------------------------------------------------
# openrouter | gemini | anthropic. See aidp/ai/llm.py.
#
# OpenRouter is the default: one key for rule reading, assessment verdicts,
# figure descriptions, summaries, chunk preambles and embeddings. Every request
# sends `data_collection: deny` and is pinned to OPENROUTER_PROVIDERS, so client
# documents never reach a host that trains on prompts or a host you did not
# choose. Never commit a real key.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FAST_MODEL=openai/gpt-4.1-nano
# One host, not a list: the same prompt answered by two different hosts is two
# slightly different answers, and a report that changes between runs of an
# unchanged design is the complaint this setting exists to avoid.
OPENROUTER_PROVIDERS=openai
# Demand zero-data-retention endpoints. gpt-4.1-mini has none, and OpenRouter
# refuses such a request rather than falling back, so leave this off with it.
OPENROUTER_ZDR=off

# Gemini, still supported with LLM_PROVIDER=gemini:

# Never commit a real key here. This file is tracked and the repository is
# public; a key pasted into it is published the moment it is pushed.
GEMINI_API_KEY=
# Flash-class by default: the chunk preamble runs once per chunk, so it is the
# cost-dominant call in the pipeline.
# Pin a real version rather than a moving alias like `gemini-flash-latest`:
# a run records the model that produced it, and an alias that changes under
# you makes a past assessment unreproducible. Google retires models — 2.5-flash
# now returns 404 "no longer available to new users" on new keys.
GEMINI_MODEL=gemini-3.5-flash

# Without a key the pipeline still runs: figures are stored but not described,
# and chunks embed without a preamble. Both are logged as ingest issues.

# A reference standard's rules are read by the model, which answers with line
# numbers only; code checks every number and slices the text itself. Two
# independent readings cross-check each other. Set RULES_READINGS=1 to halve the
# cost and lose that check, or RULES_BY_MODEL=off to use the rule-based parser
# alone. See aidp/parsing/rules.py.
# RULES_BY_MODEL=on
# RULES_READINGS=2

# The largest submission a whole-document assessment reads at once, in tokens.
# Above it the run falls back to search and says so on the run. Every clause of
# a run sends the whole document (cached by the provider after the first), so
# this is a cost ceiling, not a context limit. See aidp/whole_document.py.
# WHOLE_DOCUMENT_MAX_TOKENS=250000

# Falling back to Claude is one variable — LLM_PROVIDER=anthropic — plus:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-5
# CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# --- Embeddings -------------------------------------------------------------
# Gemini covers this too, so one key does both halves of the AI work. (Anthropic
# has no embeddings endpoint at all, which is why running Claude forces a second
# vendor purely for vectors.)
#
# EMBEDDING_DIMS must match the vector(N) width in the Prisma migration, which
# is currently 1024. gemini-embedding-001 truncates to any width via
# outputDimensionality, so 1024 needs no migration. Changing to a model with a
# fixed different width does; the worker asserts the match on the first batch
# rather than failing later with a confusing insert error.
#
# OpenRouter is the default, with the same key as the model calls. Must match
# EMBEDDING_* in AIDP/.env.local exactly — search embeds its question there.
#
# CHANGING THE EMBEDDING MODEL: every stored vector belongs to the model that
# made it, and search only reads the configured model's vectors. After a change,
# run `python scripts/reembed.py --apply` (see that file) so existing documents
# and standing decisions are found again.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMS=1024
#   Gemini: EMBEDDING_PROVIDER=gemini  EMBEDDING_MODEL=gemini-embedding-001  GEMINI_API_KEY=

# Alternatives:
#   EMBEDDING_PROVIDER=voyage  EMBEDDING_MODEL=voyage-3        VOYAGE_API_KEY=
#   EMBEDDING_PROVIDER=openai  EMBEDDING_MODEL=text-embedding-3-large  OPENAI_API_KEY=

# --- Object storage ---------------------------------------------------------
# local | app
#
#   local  a directory shared with the Next.js app through a mounted volume.
#          Development needs no cloud account.
#   app    blobs live in UploadThing, reached through the app's internal
#          endpoint. The workers deliberately do NOT hold the UploadThing token
#          — it exists only in the app, so rotating it does not mean
#          redeploying two runtimes.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/.storage

# Required when STORAGE_BACKEND=app. The secret must match the app's
# WORKER_SHARED_SECRET exactly. Generate with: openssl rand -base64 32
# APP_BASE_URL=http://host.docker.internal:3000
# WORKER_SHARED_SECRET=

# --- Queue tuning -----------------------------------------------------------
# How long a claimed job stays invisible to other workers. Handlers heartbeat to
# extend it, so this is the ceiling on how long a crash goes unnoticed.
LEASE_SECONDS=600
# Adaptive backoff bounds. Idle polling at 30s is a few indexed lookups a minute.
POLL_MIN_SECONDS=1
POLL_MAX_SECONDS=30
