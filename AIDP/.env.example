# --- Better Auth -----------------------------------------------------------
# Required in production. Sessions are signed with this; rotating it logs
# everyone out. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Only needed if the auth API is served from a different origin than the app.
# NEXT_PUBLIC_BETTER_AUTH_URL=

# --- Platform administrators ------------------------------------------------
# Comma-separated emails that get the operator console at /admin — every
# company on the platform, their people, and their model spend. Not their
# documents: that boundary is enforced in src/lib/access/platform.ts.
#
# Bootstrap only. An account listed here is promoted on its next sign-in, and
# the `isPlatformAdmin` column is the authority from then on — so *removing* an
# email here does not demote anybody. Leave it empty and nobody is an operator,
# which is the right default for a fresh database.
PLATFORM_ADMIN_EMAILS=

# --- Database (Neon Postgres) ----------------------------------------------
# Neon Console → your project → Connection string → "Connection pooling" ON.
# The pooled host has "-pooler" in it; that is the one the app should use, so
# serverless invocations share a bounded number of Postgres connections.
#
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# The *direct* (non-pooled) string — the same host with "-pooler" removed.
# Neon's pooler runs in transaction mode, which can't hold the session-level
# advisory lock `prisma migrate` takes, so migrations can hang against it.
# prisma.config.ts uses this automatically for `db:migrate` / `db:deploy` when
# it is set, and falls back to DATABASE_URL when it isn't. The app itself always
# uses the pooled DATABASE_URL above.
#
#   postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/dbname?sslmode=require
DIRECT_DATABASE_URL=

# --- Email (optional) ------------------------------------------------------
# Without this, password-reset links are printed to the server console in dev.
# Wire the provider up in sendResetPassword() in src/lib/auth-options.ts.
RESEND_API_KEY=

# --- Document ingestion -----------------------------------------------------
# Where uploaded PDFs and extracted figure images live. The Python workers in
# ../Workers read the same bucket, so these must agree with Workers/.env.
#
# local  writes under STORAGE_LOCAL_PATH; docker-compose mounts that directory
#        into the workers, so development needs no cloud account
# s3     any S3-compatible endpoint — AWS S3, Cloudflare R2, MinIO
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.storage

# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Query-side embeddings. Search embeds the question here and the chunks in the
# worker, so the provider and model MUST match Workers/.env or the vectors are
# incomparable.
#
# Gemini covers embeddings as well as the figure/preamble work, so one key does
# both. (Anthropic has no embeddings endpoint, which is why the Claude path needs
# a second vendor purely for vectors.)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=1024
GEMINI_API_KEY=

# Alternatives:
#   EMBEDDING_PROVIDER=voyage  EMBEDDING_MODEL=voyage-3  VOYAGE_API_KEY=
#   EMBEDDING_PROVIDER=openai  EMBEDDING_MODEL=text-embedding-3-large  OPENAI_API_KEY=

# --- Seeding scripts (scripts/seed-*.mts) -----------------------------------
# Passwords the one-off seeding scripts set on real accounts. Read from the
# environment rather than written into the scripts, because everything under
# scripts/ is tracked and this repository is public — a password committed once
# stays in the history after it is edited out.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
SATYAM_ADMIN_PASSWORD=
