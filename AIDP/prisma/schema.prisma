// Dexter auth schema.
//
// These four models are Better Auth's core tables. The field names are not
// arbitrary — Better Auth addresses them directly through the Prisma adapter,
// so they must match `getAuthTables()` in @better-auth/core exactly. The
// `@@map` on each model pins the physical table to the singular, lowercase
// name Better Auth expects while leaving the Prisma model PascalCase.
//
// Adding a field here is only half the job: anything the sign-up form sends
// also has to be declared in `user.additionalFields` in src/lib/auth-options.ts,
// or Better Auth will reject it as an unknown field before it reaches Postgres.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 reads the connection string from prisma.config.ts, not from here.
datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Operator of the platform, not a customer — see src/lib/access/platform.ts.
  ///
  /// A column rather than a check against an environment variable, because the
  /// admin console has to *list* administrators and an env var cannot be
  /// joined. `PLATFORM_ADMIN_EMAILS` still exists, but only to promote a
  /// matching account on sign-in: it bootstraps the first administrator on a
  /// fresh database and is never consulted afterwards.
  ///
  /// This grants sight of every organisation's people and spend. It grants no
  /// sight of their documents — see the note on the admin queries.
  isPlatformAdmin Boolean @default(false)

  // Collected at sign-up. Required in the app, so required here — see
  // `additionalFields` in src/lib/auth-options.ts for the matching declaration.
  company String
  country String
  phone   String

  sessions Session[]
  accounts Account[]

  // Which customer organisations this person can see. Consultants span several.
  memberships Membership[]

  // Standing decisions this person has ruled on.
  clauseDrafts ClauseDraft[]
  decisions Decision[]

  // Submissions this person has approved, sent back, or escalated.
  outcomes SubmissionOutcome[]

  // Their place on a customer's roster. A consultant working for two customers
  // appears on two, which is why this is a list and not a single row.
  rosterEntries RosterEntry[]

  // Documents they put into the system. Drives cost attribution: the model
  // spend of a run lands on whoever submitted the work.
  uploads Document[]

  // Model spend attributed to them.
  usage TokenUsage[]

  // Pieces of work they opened. Attribution only — a project belongs to the
  // organisation, and outlives whoever started it.
  projects Project[]

  // Model keys they set for their organisation. Attribution only: the key
  // belongs to the company, and keeps working after the administrator who
  // pasted it has left.
  providerCredentials ProviderCredential[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  // For email/password this holds the hash. Better Auth marks it
  // `returned: false`, so it never leaves the server in an API response.
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

// Backs email verification and the password-reset flow.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organisation {
  id   String @id @default(cuid())
  name String
  // URL-safe handle. Stable once issued — it appears in paths.
  slug String @unique

  /// Company details, shown and edited on /dashboard/profile.
  ///
  /// Held on the organisation rather than on whoever registered it. The person
  /// who signed up may leave, and the company's own contact details should not
  /// leave with them — the same reason the technology reference was moved off
  /// the user before it was retired.
  ///
  /// All optional: an organisation is created the moment somebody registers,
  /// long before anyone has filled any of this in, and a required field would
  /// mean inventing a value nobody chose.
  primaryContact String @default("")
  contactEmail   String @default("")
  contactPhone   String @default("")
  country        String @default("")
  industry       String @default("")
  notes          String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  documents   Document[]
  chunks      Chunk[]
  jobs        Job[]
  frameworks  Framework[]
  runs        AssessmentRun[]
  clauseDrafts ClauseDraft[]
  decisions   Decision[]
  outcomes    SubmissionOutcome[]
  roster      RosterEntry[]
  projects    Project[]
  usage       TokenUsage[]
  aiCache     AiCache[]

  /// The company's own model key, when they have brought one. Absent is the
  /// normal state and means the deployment's own key does their work.
  credential ProviderCredential?

  @@map("organisation")
}

model Membership {
  id String @id @default(cuid())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// "owner"  — the customer's own administrator. Registered the organisation,
  ///            controls who else gets in, sees the spend. There is always at
  ///            least one, and the last one cannot be removed.
  /// "member" — an employee the owner admitted. Works in the product.
  ///
  /// "consultant" and "viewer" predate this and are treated as "member"
  /// everywhere; see ROLES in src/lib/access/roles.ts, which is the only place
  /// that decides what a role may do.
  role String @default("member")

  createdAt DateTime @default(now())

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@map("membership")
}

/// Who a customer has admitted to their organisation.
///
/// Membership says a person *has* access. This says whether they are *supposed
/// to* — and it is the row the owner actually manages. The two are deliberately
/// separate, because the useful states here exist before an account does: an
/// owner uploads a staff spreadsheet, gets two hundred people they have never
/// granted anything to, and picks a dozen. Those rows have no `userId` and must
/// not confer access; making them memberships would have admitted the entire
/// payroll the moment the file was parsed.
///
/// So this is the authority on admission and `Membership` is its consequence.
/// `status` moves imported -> allowed -> active, or sideways to revoked, and
/// `syncMembership` in src/lib/access/roster.ts is the single place that turns
/// a status into a membership. Revoking deletes the membership and the person's
/// sessions; the row stays, because "was admitted in March, revoked in June" is
/// the question an audit asks and a deleted row cannot answer it.
model RosterEntry {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Lower-cased on every write. This is the identity — an employee is a
  /// mailbox until they register, and matching has to survive "A.Patel@" versus
  /// "a.patel@" arriving from two different spreadsheets.
  email String

  /// From the spreadsheet, and only ever a label. Once the person registers,
  /// their account name is what the UI shows: they are the authority on their
  /// own name, not whatever HR typed.
  name       String @default("")
  jobTitle   String @default("")
  department String @default("")

  /// "imported" — loaded from a file or typed in. No access whatsoever.
  /// "allowed"  — admitted, but has not signed in yet. May register.
  /// "active"   — admitted and holding an account.
  /// "revoked"  — admission withdrawn. Kept for the record, never deleted.
  status String @default("imported")

  /// The membership role to grant on admission. See Membership.role.
  role String @default("member")

  /// "manual" | "import" | "signup" — how the row came to exist. An owner
  /// looking at a list of two hundred names needs to know which they typed.
  source String @default("manual")

  /// Set once the person registers, which is also what makes them "active".
  /// Null for everyone who has been admitted but has not signed up yet.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Attribution for the two decisions that matter, denormalised beside the ids
  /// for the same reason as Decision.decidedByName: the record has to keep
  /// naming the person after their account is gone.
  allowedAt     DateTime?
  allowedById   String?
  allowedByName String    @default("")
  revokedAt     DateTime?
  revokedById   String?
  revokedByName String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per mailbox per organisation. Re-importing the same spreadsheet
  /// updates the rows it already created instead of duplicating them, which is
  /// what makes a second upload safe.
  @@unique([organisationId, email])
  @@index([organisationId, status])
  @@map("roster_entry")
}

/// Model spend, one row per provider call.
///
/// Written by the workers (Workers/aidp/usage.py) and by the app, against the
/// same table, because the two both call models and an owner asking "what has
/// this cost us?" does not care which process made the request.
///
/// Attributed to a person through `userId`, which is copied from
/// `Document.uploadedById` at the moment the job runs. Whoever submitted the
/// work owns its cost — the alternative is a bill attributed to nobody, which
/// is exactly the number an owner cannot act on.
///
/// One row per call rather than a running total per job. A total is a number
/// that can only ever be wrong in ways nobody can reconstruct; rows can be
/// grouped into any total later, and a run of a hundred clauses writing a
/// hundred rows costs nothing next to the hundred model calls it just made.
model TokenUsage {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Null when the work cannot be traced to a person — a document uploaded
  /// before this column existed, or an account since deleted. Counted in the
  /// organisation's total either way, and shown as unattributed rather than
  /// quietly dropped.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Deliberately not foreign keys. Usage outlives the thing that caused it:
  /// deleting a document must not erase the record of what it cost, or the
  /// month's spend changes retrospectively every time someone tidies up.
  documentId String?
  runId      String?

  /// "parse" | "chunk" | "embed" | "analyse" | "app"
  stage String
  /// "llm" | "embedding"
  kind  String

  provider String
  model    String

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)

  /// True when the provider returned no usage figures and these were derived
  /// from input size — every embedding endpoint here does that. Flagged rather
  /// than blended in, so a spend figure can say how much of itself is a guess.
  estimated Boolean @default(false)

  /// Which key the provider billed: "platform" for the deployment's own, and
  /// "organisation" when the customer brought their own and paid directly.
  ///
  /// Without this the operator console counts a customer's own provider bill as
  /// the platform's spend, which is wrong in both directions at once — it
  /// overstates what the product costs to run and invites billing a customer
  /// for tokens they already paid for. Tokens are still recorded either way:
  /// an administrator wants to know what their assessments consumed regardless
  /// of which card the provider charged.
  payer String @default("platform")

  createdAt DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([organisationId, userId])
  @@index([documentId])
  @@map("token_usage")
}

/// A piece of work: one design under review, or a design and the revisions
/// that follow it, measured against the organisation's standards.
///
/// Employees open these and put their submissions inside. Reference standards
/// deliberately do *not* belong to one — they are the organisation's rules,
/// curated by its administrator, and every project is measured against the
/// same set. A standard that belonged to a project would quietly become a
/// different yardstick per project, which is the opposite of what a standard
/// is for.
///
/// Archived rather than deleted. A project holds documents, findings and
/// recorded decisions; deleting one would take the record of a review with it,
/// and "we assessed this in March" is exactly what an audit asks about.
model Project {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name        String
  description String @default("")

  /// "active" | "archived"
  status String @default("active")

  /// Who opened it. Nullable, and paired with a denormalised name, for the same
  /// reason as Decision.decidedByName: the record has to keep saying who
  /// started this after their account is gone.
  createdById   String?
  createdBy     User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  /// Assessments of the project as a whole. A design's own runs hang off the
  /// document, not here.
  runs      AssessmentRun[]
  /// Rulings that apply to this project alone — a breach the board allowed for
  /// this piece of work and nowhere else. See Decision.scope.
  decisions Decision[]

  /// One name per organisation. Two projects called "Portal" in the same
  /// workspace is a support ticket waiting to happen, and the constraint gives
  /// the create form something specific to say instead of silently making a
  /// second one.
  @@unique([organisationId, name])
  @@index([organisationId, status])
  @@map("project")
}

model Document {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The piece of work this belongs to.
  ///
  /// Null for reference standards, which are organisation-wide by design, and
  /// null for designs that predate projects — the backfill gives those a home,
  /// but the column stays optional because standards legitimately have none.
  ///
  /// `SetNull` rather than a cascade: a project is archived, not deleted, but
  /// if one ever is removed the submissions inside it must not go with it.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Who submitted it. Nullable because the column arrived after the first
  /// documents did, and because the account may since have been deleted.
  ///
  /// This is what makes per-person spend possible: a worker running a job knows
  /// the document, and the document knows the person. `onDelete: SetNull` so
  /// removing an employee does not take their organisation's documents with
  /// them — the work belongs to the customer, not to the individual.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // "reference" — a standards document; stops after embed.
  // "assessed"  — a design submitted for review; continues into analyse.
  role String @default("reference")

  title         String
  // Cover-page identifiers, when the document carries them: "DOC-SEC-STD", "V-1.0".
  docCode       String?
  version       String?
  effectiveDate String?

  // Lifted off the page footer during parse, not typed by a human. Drives
  // access control — see Data Standards §8.1.
  sensitivity String?

  // Object-storage key, not a URL: the bucket may be private and the signing
  // scheme may change.
  storageKey String
  mimeType   String @default("application/pdf")
  byteSize   Int
  // Content hash. Re-uploading the same bytes must not re-parse or re-embed.
  sha256     String

  pageCount Int?
  // "prose-clause" | "table-principle" | "mixed" — detected, not declared.
  profile   String?

  /// What this document as a whole is trying to do, written once from the whole
  /// of it — see the summarise pass in Workers/aidp/stages/chunk.py.
  ///
  /// Retrieval hands the judge eight passages and nothing else, and the judge
  /// prompt says so: "you cannot see the rest of the document". That is
  /// survivable for a standard, whose clauses are self-contained by
  /// construction. It is not survivable for a submission. A deck comparing two
  /// vendors for a B2B payments programme reads, eight passages at a time, as
  /// unrelated claims about two products, and a verdict reached that way
  /// answers a question nobody asked.
  ///
  /// So the document's own purpose is written down once and travels with every
  /// clause. Null when no model was configured at chunk time; the judge simply
  /// goes without, exactly as it did before this existed.
  summary String?

  /// True when this document's structure or rules were read by a model rather
  /// than parsed from its own formatting — see Workers/aidp/parsing/ai_structure.py
  /// and rules.py.
  ///
  /// A record of how the document was read, and nothing more. It once gated
  /// assessment on a person confirming the reading, but a model now reads every
  /// standard, deck and workbook, so the gate stood in front of every upload.
  /// The two confirmation columns stay so documents confirmed under it still
  /// say so; nothing writes them any more.
  structureInferred    Boolean   @default(false)
  structureConfirmedAt DateTime?
  structureConfirmedBy String?

  // "pending" | "parsing" | "chunking" | "embedding" | "ready" | "failed"
  status        String  @default("pending")
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections DocumentSection[]
  chunks   Chunk[]
  jobs     Job[]
  issues   IngestIssue[]

  // A reference standard's text as numbered lines, and every model reading of
  // its rules. See Workers/aidp/parsing/rules.py.
  sourceLines     SourceLine[]
  ruleExtractions RuleExtraction[]
  lineLabels      LineLabel[]

  // Reference documents belong to frameworks; assessed documents get runs.
  frameworks FrameworkDocument[]
  runs       AssessmentRun[]

  // One live document per organisation per file. A second upload of the same
  // bytes resolves to this row instead of starting the pipeline again.
  @@unique([organisationId, sha256])
  @@index([organisationId, status])
  @@map("document")
}

model DocumentSection {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Reading order within the document. This is the identity, not `numberText`:
  // real documents repeat section numbers (the sample corpus has two 9.1.1s
  // from Word auto-numbering drift).
  ordinal     Int
  // "3.2", "Appendix A" — as printed, for display and citation only.
  numberText  String?
  title       String
  // "Security Standards › 3. Identity and Access Management › 3.2 Authentication"
  headingPath String
  depth       Int     @default(1)

  pageStart Int?
  pageEnd   Int?

  // Prose that belongs to the section itself rather than to any clause. Also
  // the parent chunk when a query is broader than a single clause.
  introText String @default("")

  // No clause, no table, no figure, no prose. Surfaced as an issue rather than
  // silently dropped — a compliance tool that swallows an empty section will
  // later answer from a sibling document and sound certain.
  isEmpty Boolean @default(false)

  clauses Clause[]
  tables  TableBlock[]
  figures Figure[]

  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("document_section")
}

model Clause {
  id String @id @default(cuid())

  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  ordinal Int
  title   String?

  // The template's own four parts. `guidance` only appears in Solution
  // Architecture, which pairs each standard with the technologies to implement
  // it — the prescription attached to the diagnosis.
  statement    String   @default("")
  rationale    String   @default("")
  requirements String[] @default([])
  guidance     String[] @default([])

  pageStart Int?
  pageEnd   Int?

  // "parser" when the rule-based parser found it by its shape; "model" when a
  // model pointed at the lines and code sliced the text (see
  // Workers/aidp/parsing/rules.py); "restored" when a reviewer promoted lines
  // the model had set aside; "authored" when a reviewer sharpened an earlier
  // version of this clause from what an assessment found (see ClauseDraft).
  origin     String @default("parser")
  // For a model-read or restored clause, the source line refs each part came
  // from: { span, heading, statement, rationale,
  // requirements: [{ refs, strength }], guidance, references }.
  sourceRefs Json?

  /// Replaced by a sharper version of itself, and no longer judged.
  ///
  /// A clause is never edited in place, for the reason the register gives: a
  /// `Finding` denormalises the clause's ref, title and statement but *not* its
  /// requirements — and requirements are exactly what sharpening adds. Rewrite
  /// one in place and the report from six months ago says "covered" against a
  /// clause whose requirements no longer exist anywhere, which is the one thing
  /// an assessment has to be able to answer for.
  ///
  /// So the old row stays exactly as it was, keeps its ordinal, and stops being
  /// judged, while the sharper version is appended at the end of its section's
  /// reading order exactly as a restored rule is. The clause reference does not
  /// move with it: that comes from the *section's* number, which is why a
  /// decision anchored to §9.3 still finds the sharpened clause.
  ///
  /// `@@unique([sectionId, ordinal])` is therefore a *partial* unique index in
  /// the migration — one live clause per ordinal, any number of superseded ones
  /// behind it, and an ordinal a superseded row vacated is free again. Prisma
  /// cannot express that, which is why it is not declared here; see
  /// `isUniqueViolation` in the documents actions for the 23505 that surfaces
  /// instead of Prisma's P2002.
  supersededById String? @unique
  supersededBy   Clause? @relation("ClauseSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Clause? @relation("ClauseSupersedes")

  /// Where an `authored` clause came from: the reviewed finding that showed the
  /// earlier wording was not specific enough to judge against, and its run.
  /// Not foreign keys, and for the same reason `Finding.clauseId` is not one —
  /// a clause has to outlive the report that prompted it.
  sourceFindingId String?
  sourceRunId     String?
  /// Kept beside the relation-free ids so the library still attributes the
  /// wording after the person who approved it has left — the same reasoning as
  /// `Decision.decidedByName`.
  authoredByName  String    @default("")
  authoredAt      DateTime?

  tables TableBlock[]
  drafts ClauseDraft[]

  /// Reading order within a section, and the only index the clause lookups
  /// need: every one of them starts from a section and filters the superseded
  /// out. The uniqueness of a live ordinal is enforced by the partial index in
  /// the migration, not here.
  @@index([sectionId, supersededById])
  @@index([sectionId])
  @@map("clause")
}

/// A sharper version of one clause, proposed from one assessment, not yet live.
///
/// The gap this fills: a customer's standards library is not only small, it is
/// vague. "Ensure resilience" cannot be judged, so a design that retries
/// without a dead-letter path comes back `partial` for ever and nobody writes
/// down what the clause actually meant. A reviewer who has just confirmed that
/// verdict knows what it meant, and this is the shortest path from knowing it
/// to the library saying it.
///
/// Deliberately a staging table rather than a direct edit:
///
///  1. **A model drafts, a person decides.** The requirements are written by a
///     model from the clause and the finding, then checked (see
///     Workers/aidp/standards.py) and shown for approval. Nothing reaches the
///     library that a person has not read.
///  2. **One place to see what is pending.** A library that gained a
///     requirement every time somebody confirmed a verdict would be a library
///     nobody could review.
model ClauseDraft {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The clause this sharpens. Cascades: a draft against a clause that a
  /// re-parse has removed is proposing an addition to something that no longer
  /// exists, and keeping it would offer the reviewer a dead end.
  clauseId String
  clause   Clause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  /// Denormalised so the queue still reads correctly beside a clause that has
  /// since been superseded by somebody else's draft.
  clauseRef   String @default("")
  clauseTitle String @default("")

  /// The reviewed finding that prompted it, and its run. Relation-free for the
  /// same reason as Clause.sourceFindingId.
  sourceFindingId String
  sourceRunId     String

  /// "drafting" — queued, or a worker is on it
  /// "ready"    — requirements written and checked, waiting for a person
  /// "failed"   — the model could not be reached, or wrote nothing usable
  /// "applied"  — a new clause carries these requirements
  /// "discarded" — a person read it and said no
  state String @default("drafting")

  /// The requirement lines proposed, in the words a standard would use. Only
  /// ever additions: the statement and rationale of the clause are left alone,
  /// because a model allowed to rewrite the rule would quietly change what the
  /// customer requires. See the prompt in Workers/aidp/ai/llm.py.
  requirements String[] @default([])

  /// The model's one line on what the earlier wording left unsaid. Shown to the
  /// reviewer as the case for the change, never stored on the clause.
  note String @default("")

  model String?
  error String?

  /// Lines the model proposed that the checks refused, each with the reason —
  /// not normative, already in the clause, or lifted from the design rather
  /// than written as a rule. Kept so a reviewer can see what was thrown away
  /// instead of wondering why one requirement came back.
  setAside Json @default("[]")

  /// The clause the approval created. Null until then.
  appliedClauseId String?

  requestedById   String?
  requestedBy     User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByName String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live draft per finding. A reviewer pressing twice must not queue two
  /// model calls against the same clause, and two drafts of one finding would
  /// read as two independent proposals agreeing.
  @@index([organisationId, state])
  @@index([clauseId])
  @@map("clause_draft")
}

// ---------------------------------------------------------------------------
// Rules read by a model
//
// A standard's rules are read by a model that is only allowed to point: it sees
// numbered lines and answers with line numbers. Code checks every number and
// slices the words itself, so no rule can contain text the document does not.
// These tables keep the evidence — the text as read, every reading, and what
// was set aside with the model's stated reason — so a reviewer can see why a
// line is or is not a rule, and a disagreement can be traced after the fact.
// ---------------------------------------------------------------------------

model SourceLine {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Position in the document from 0 — the number the model saw and answered in.
  ordinal Int
  // The same position for people: "L12" is the twelfth paragraph, "T3-r4" the
  // fourth row of the third table, "T3-h" that table's column line.
  ref     String
  // "text" | "heading" | "bullet" | "table_header" | "table_row"
  kind    String
  page    Int?
  text    String
  // The section the line falls in, by ordinal, as the parse left it.
  sectionOrdinal Int?
  // Heading depth, when the document declared one.
  depth   Int?

  @@unique([documentId, ordinal])
  @@map("source_line")
}

model RuleExtraction {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // 1 is the first reading; 2 is the cross-check, or the retry when 1 failed.
  attempt       Int
  // "accepted" | "failed"
  status        String
  // Whether this reading's rules are the clauses stored for the document.
  adopted       Boolean @default(false)
  provider      String
  model         String
  promptVersion String
  error         String?
  // Lines, lines covered, rules, requirements, lines set aside per label.
  stats         Json    @default("{}")
  // Every request made for this reading: the line range, whether it was
  // believed and why not, and the raw reply — line numbers and short reasons.
  calls         Json    @default("[]")

  createdAt DateTime @default(now())

  labels LineLabel[]

  @@index([documentId])
  @@map("rule_extraction")
}

model LineLabel {
  id String @id @default(cuid())

  extractionId String
  extraction   RuleExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Inclusive range of SourceLine ordinals.
  fromOrdinal Int
  toOrdinal   Int
  // "furniture" | "scope" | "reference" | "process_rule" | "guidance" | "other"
  label       String
  // The model's own words for what these lines are.
  reason      String  @default("")

  // Set when a reviewer decided these lines are a rule after all.
  restoredAt       DateTime?
  restoredBy       String?
  restoredClauseId String?

  @@index([documentId])
  @@index([extractionId])
  @@map("line_label")
}

model TableBlock {
  id String @id @default(cuid())

  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  // Set when the table belongs to a specific standard rather than to the
  // section at large — Security §3.2 carries its password policy inside the
  // clause, not beside it.
  clauseId  String?
  clause    Clause?         @relation(fields: [clauseId], references: [id], onDelete: SetNull)

  ordinal Int
  caption String?

  columns String[] @default([])
  // Array of objects keyed by column header. Empty cells are stored as null,
  // never omitted: drop them and every later value shifts one column left,
  // turning "not specified" into the previous row's answer.
  rows    Json     @default("[]")

  pageStart  Int?
  pageEnd    Int?
  // Extraction confidence. Low values raise an IngestIssue for review.
  confidence Float @default(1)

  @@index([sectionId])
  @@map("table_block")
}

model Figure {
  id String @id @default(cuid())

  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  ordinal Int
  page    Int
  // [x0, y0, x1, y1] in PDF points, so a citation can highlight the region.
  bbox    Float[] @default([])

  storageKey  String
  caption     String?
  // The model's description of the diagram. For vector-drawn figures this is
  // the only searchable text that exists — the PDF text layer under them is
  // empty.
  //
  // It is also *generated*, and once it becomes a chunk nothing distinguishes it
  // from text lifted off the page. That is the risk worth designing against: not
  // a corrupted index — embeddings are per-chunk, and a bad one re-embeds for a
  // single API call — but fabricated evidence that reads like a quotation.
  description String  @default("")

  // A human's correction, when the model got it wrong. Kept beside the original
  // rather than overwriting it, so the disagreement stays visible and the vision
  // model's accuracy stays measurable.
  correctedDescription String?

  // "pending" | "confirmed" | "corrected" | "rejected"
  //
  // Review is deliberately non-blocking: the document indexes immediately and a
  // figure is reviewed when someone has reason to care. Gating ingestion on it
  // would put a queue of human work in front of every upload — twenty decisions
  // before a customer's library is searchable at all.
  reviewState String    @default("pending")
  reviewNote  String?
  reviewedAt  DateTime?

  // Drawing primitives plus text runs inside the region. A dense diagram is
  // where vision models actually struggle; a three-box flow is not. Sorts the
  // review queue by risk rather than by page order.
  complexity Int @default(0)

  @@index([sectionId])
  @@map("figure")
}

model Chunk {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // "clause" | "table_row" | "table" | "figure" | "section"
  sourceKind String
  // Row id of the clause/table/figure this came from. Not a foreign key: one
  // column can't reference four tables, and the cascade already runs through
  // documentId.
  sourceId   String?

  ordinal     Int
  headingPath String
  // What gets embedded: heading path, contextual preamble, then the body.
  text        String
  tokenCount  Int     @default(0)
  // Inherited from the document. Filtered on at query time so Restricted
  // material can't surface through a broad question.
  sensitivity String?

  pageStart Int?
  pageEnd   Int?

  // Hash of the text. Unchanged chunks are not re-embedded on re-parse.
  contentHash String

  embeddings Embedding[]

  @@unique([documentId, ordinal])
  @@index([organisationId])
  @@index([documentId])
  @@map("chunk")
}

model Embedding {
  id String @id @default(cuid())

  chunkId String
  chunk   Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  // Recorded per row so a model change can be rolled out side-by-side instead
  // of as a big-bang re-embed.
  model String
  dims  Int

  // pgvector. Prisma has no native type for it, so the column is declared here
  // and written by raw SQL from the Python worker. The HNSW index lives in the
  // migration.
  vector Unsupported("vector(1024)")?

  createdAt DateTime @default(now())

  @@unique([chunkId, model])
  @@map("embedding")
}

model Job {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The document this job is about.
  ///
  /// Null on an analyse job for a project run, which is about every design in
  /// the project rather than one of them; those are found by the run id on
  /// `payload` instead. Every parse, chunk and embed job has one by
  /// construction — they are the stages that read a file.
  documentId     String?
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // "parse" | "chunk" | "embed" | "analyse"
  stage String
  // "queued" | "leased" | "done" | "failed" | "dead"
  state String @default("queued")

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  // Backoff target. A retry is invisible to claimers until now() passes this.
  runAfter   DateTime  @default(now())
  leaseUntil DateTime?
  leaseOwner String?

  // Follows a document across every stage. Required by Data Standards §9.3 and
  // the customer's own Integration principle 12.
  correlationId String
  payload       Json    @default("{}")
  lastError     String?
  // What the worker holding the job is doing: step, done/total, finished steps
  // and when the attempt started. See Workers/aidp/progress.py and
  // src/lib/ingest/pipeline.ts. Only a courtesy — nothing gates on it.
  progress      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, state, runAfter])
  @@index([state, leaseUntil])
  @@index([documentId])
  @@map("job")
}

model IngestIssue {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // "high" | "medium" | "low"
  severity   String
  // "section_missing" | "section_empty" | "toc_mismatch" | "table_low_confidence"
  // | "figure_undescribed" | "needs_ocr"
  kind       String
  detail     String
  // Where in the document, when we know.
  page       Int?
  sectionRef String?

  createdAt DateTime @default(now())

  @@index([documentId, severity])
  @@map("ingest_issue")
}

// ---------------------------------------------------------------------------
// Assessment
//
// This is the product. Retrieval runs backwards from the usual shape: the
// reference clause is the query, not the user. For each of the ~120 clauses in
// a customer's framework, the analyse worker searches the submitted design and
// classifies what it finds. Nobody types a question.
//
// A run pins the framework version it ran against, because a finding that says
// "breaches §3.2" is meaningless once §3.2 has been rewritten.
// ---------------------------------------------------------------------------

/// A versioned set of reference documents — what assessments measure against.
model Framework {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name    String
  version Int    @default(1)

  /// The consultancy's house standard rather than the customer's own. Findings
  /// record which layer a clause came from: "breaches your own standard" and
  /// "below industry baseline" are different conversations in a review.
  isBaseline Boolean @default(false)

  /// When this version stopped being the one to assess against, because a
  /// standard in it was removed from the library.
  ///
  /// Needed because the membership rows cascade away with the document, so the
  /// set comparison in `resolveFramework` cannot see that anything changed —
  /// the evidence went with the deletion. Without this the same framework id
  /// quietly came to mean a smaller set of standards than the runs pinned to it
  /// were measured against, which is the one thing versioning them exists to
  /// prevent. A superseded version is never reused; it stays readable, and the
  /// runs that used it keep their own clause counts.
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents FrameworkDocument[]
  runs      AssessmentRun[]

  @@unique([organisationId, name, version])
  @@index([organisationId])
  @@map("framework")
}

model FrameworkDocument {
  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@id([frameworkId, documentId])
  @@index([documentId])
  @@map("framework_document")
}

model AssessmentRun {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The submission under assessment — a document with role='assessed'.
  ///
  /// Null on a project run, which assesses every design in a project at once:
  /// there is no single submission then, and `projectId` says what the scope
  /// was. Exactly one of the two is set, which `startProjectAssessment` and the
  /// worker's `designs()` both rely on.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// The project under assessment, when every design in it was read together.
  ///
  /// A clause is judged once against all of them, because a design document
  /// rarely stands alone: what one deck leaves out the next one answers, and
  /// per-document runs reported those as gaps. Null on a single-design run.
  ///
  /// `SetNull` for the same reason as Document.projectId: a project is archived,
  /// not deleted, and a report must outlive one if it ever is removed.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  // "queued" | "running" | "complete" | "failed"
  state String @default("queued")

  /// Progress, so a run over a hundred clauses can show more than a spinner.
  totalClauses     Int @default(0)
  completedClauses Int @default(0)

  /// Recorded per run: a verdict is only interpretable alongside the model that
  /// reached it, and these will be re-run as models change.
  model         String?
  failureReason String?

  // How the judge saw the design. "retrieval": the passages a search found for
  // each clause. "document": the whole document, quoted, with every quote
  // checked word for word against it. See Workers/aidp/whole_document.py.
  mode           String  @default("retrieval")
  // Anything a reader of these results needs to know about how they were
  // reached — above all, a whole-document run that fell back to search.
  note           String?
  // The run this one was started alongside, when both modes were run to be
  // compared.
  comparedWithId String?
  // The reverse of the findings: parts of the design no clause governs, each
  // with a quote checked against the design, and the standards a model suggests
  // adding. See Workers/aidp/coverage.py and src/lib/ingest/coverage.ts.
  coverage       Json?
  /// Improvements to the design itself, suggested once the clauses are judged and
  /// the coverage worked out — see Workers/aidp/advice.py. Advice, never a
  /// verdict. Null on runs from before it existed.
  advice       Json?
  /// Whether the technologies the design names are still supported, looked up on
  /// endoflife.date by product id alone — see Workers/aidp/lifecycle.py. Facts
  /// with a source and a date, never a verdict. Nullable: runs from before this
  /// existed have none.
  lifecycle    Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  findings Finding[]
  outcomes SubmissionOutcome[]

  @@index([organisationId, state])
  @@index([documentId])
  @@index([projectId, state])
  @@map("assessment_run")
}

model Finding {
  id String @id @default(cuid())

  runId String
  run   AssessmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// The reference clause this answers. Not a foreign key to Clause: findings
  /// have to outlive a re-parse of the reference document, and cascading them
  /// away would silently erase a reviewer's decisions.
  clauseId        String
  /// Denormalised so a finding still reads correctly after the source moves.
  clauseRef       String
  clauseTitle     String @default("")
  clauseStatement String @default("")

  // "covered" | "partial" | "absent" | "contradicts" | "needs_review"
  verdict    String
  /// 0–1, from the model. Used to demote a low-confidence "absent" — see
  /// Workers/aidp/stages/analyse.py.
  confidence Float  @default(0)
  rationale  String @default("")

  /// [{ chunkId, headingPath, page, excerpt }]. A verdict of covered, partial
  /// or contradicts with no evidence is downgraded, because a claim about a
  /// document that cites nothing in it was invented.
  evidence Json @default("[]")

  /// How well retrieval did before the model saw anything. A confident "absent"
  /// on top of weak retrieval is the failure this exists to catch.
  retrievalScore Float @default(0)

  /// [{ id, title, effect }] — the standing decisions that were in the prompt
  /// and that the model said it applied. Denormalised for the same reason as
  /// `evidence`: a report from last year has to keep explaining itself after
  /// the decision behind it has been superseded or deleted.
  appliedDecisions Json @default("[]")

  // "pending" | "confirmed" | "overridden"
  reviewerState   String    @default("pending")
  reviewerVerdict String?
  reviewerNote    String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())

  @@unique([runId, clauseId])
  @@index([runId, verdict])
  @@map("finding")
}

/// A ruling the organisation has already made, carried into future assessments.
///
/// The third leg of the product promise. Standards say what good looks like and
/// principles say why; this is what *this* customer decided when the two met a
/// real design — "KMS-managed keys in eu-west-1 satisfy encryption at rest",
/// "we accepted Kafka over Kinesis, stop raising it". Without it every
/// assessment re-litigates settled questions and the reviewer overrides the
/// same finding forever.
///
/// Two ways in: promoted from a reviewed finding (see `promote` in
/// src/lib/ingest/decisions.ts) or authored directly in the register.
model Decision {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// A short handle for the register. The statement is the ruling itself.
  title     String
  statement String
  rationale String @default("")

  /// How this should bias a verdict:
  ///   accepts   the arrangement it describes satisfies the clause
  ///   rejects   the arrangement it describes does not, and is a breach
  ///   context   neither — background the model should weigh
  effect String @default("context")

  /// How far this ruling reaches:
  ///   organisation   every assessment this customer ever runs
  ///   project        only assessments of `projectId`
  ///
  /// A review board routinely allows a breach *for one piece of work* — a
  /// migration that keeps a legacy protocol until it is retired, a pilot
  /// exempted while it is a pilot. Recorded organisation-wide, that exemption
  /// silently becomes policy and every later design inherits it.
  ///
  /// Stored as its own column rather than inferred from `projectId IS NULL`,
  /// because the two disagree in the case that matters: if the project row ever
  /// goes, a project-only exemption with a nulled `projectId` would read as
  /// organisation-wide and start applying everywhere. With the scope recorded,
  /// it matches nothing instead, and the register can say the project is gone.
  scope String @default("organisation")

  /// The project a `project`-scoped ruling applies to. Null when it applies
  /// organisation-wide, which is every decision recorded before scopes existed.
  ///
  /// `SetNull` for the same reason as Document.projectId: a project is
  /// archived, not deleted, and a ruling an audit may ask about must outlive
  /// one if it ever is removed. See the note on `scope` for what the pair means
  /// once that has happened.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// The clause this answers, when it answers one. Not a foreign key, and
  /// denormalised, for the same reason as Finding: reference documents get
  /// re-parsed and re-numbered, and a cascade would erase the review board's
  /// rulings the first time someone re-uploads a standard.
  clauseId    String?
  clauseRef   String  @default("")
  clauseTitle String  @default("")

  /// Where it came from. Null throughout when authored directly.
  sourceFindingId  String?
  sourceRunId      String?
  sourceDocumentId String?

  /// "active" | "superseded" | "expired"
  ///
  /// Decisions are never edited in place. An edit writes a new row and points
  /// the old one at it, so a run from six months ago still means what it said —
  /// the same reasoning that makes Framework versioned rather than mutable.
  status         String    @default("active")
  supersededById String?   @unique
  supersededBy   Decision? @relation("DecisionSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Decision? @relation("DecisionSupersedes")

  /// Architecture exceptions are routinely granted for a fixed term. A register
  /// that cannot expire its own entries turns into policy nobody voted for.
  effectiveFrom DateTime  @default(now())
  expiresAt     DateTime?

  decidedById   String?
  decidedBy     User?   @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  /// Kept beside the relation so the register still attributes a decision after
  /// the person who made it has left and their row is gone.
  decidedByName String  @default("")

  /// pgvector, written by raw SQL exactly like Embedding.vector — Prisma has no
  /// native type for it. Embedded as a *passage*, because clause queries are
  /// what search it.
  ///
  /// No HNSW index: a register holds hundreds of rows, not millions, and an
  /// exact scan over that is faster than a graph walk. Add one when a customer
  /// crosses ~50k decisions, which would be a different product.
  vector         Unsupported("vector(1024)")?
  embeddingModel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, status])
  @@index([organisationId, clauseRef])
  /// Every clause lookup in a run filters on the scope pair; see
  /// `for_clause` in Workers/aidp/decisions.py.
  @@index([organisationId, scope, projectId])
  @@map("decision")
}

/// What was decided about a submission once its report was read.
///
/// The assessment answers "does this design meet the standard?". This answers
/// "what happens now?", and it is the row a governance audit actually asks for:
/// who accepted this design, when, and on what basis.
///
/// Append-only. An escalation is followed by the board's own decision, and a
/// revised submission gets a new run with its own outcome, so the history is a
/// sequence rather than a field to overwrite. The most recent row for a run is
/// the current position.
model SubmissionOutcome {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  runId String
  run   AssessmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Denormalised so a document's decision history is one query, and so it
  /// still reads correctly if the run is ever re-pointed.
  ///
  /// Null when the run was over a whole project, which is signed off as one
  /// piece of work; `projectId` carries it then. Exactly one of the two is set,
  /// mirroring the run the outcome is about.
  documentId String?

  /// The project signed off, when the run was over all of its designs.
  projectId  String?

  // "approved" | "revise" | "escalated"
  decision String
  /// Why. Required for revise and escalated — an instruction with no stated
  /// basis is not an instruction, and a board asked to rule needs the question.
  note     String @default("")

  /// The report as it stood when this was decided: verdict counts, how many
  /// findings were still unreviewed, the total. Captured because findings stay
  /// editable afterwards, and "approved while three contradictions were
  /// outstanding" is exactly what an audit needs to be able to see later.
  snapshot Json @default("{}")

  decidedById   String?
  decidedBy     User?   @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  /// Kept beside the relation so a decision still names its author after the
  /// account is gone.
  decidedByName String  @default("")

  createdAt DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([documentId, createdAt])
  @@index([runId])
  @@map("submission_outcome")
}

/// Answers we have already paid a provider for.
///
/// Every expensive AI call in this pipeline is a function of its inputs, so the
/// same inputs need only be paid for once. `fingerprint` is a hash of *every*
/// input that can change the output — see Workers/aidp/cache.py, which is the
/// only place keys are built, precisely so that "what does this depend on?" has
/// exactly one answer.
///
/// Getting that key right is the whole design. A key that misses something is
/// not a slow cache, it is a cache that returns a confidently wrong answer, and
/// in a compliance tool that is worse than no cache at all. So the rule is to
/// under-normalise: the fingerprint covers the exact bytes sent to the
/// provider, with no whitespace folding or cleverness. A text that differs by a
/// space misses and costs a fraction of a penny; a false hit costs correctness.
///
/// Scoped per organisation. A cache keyed on customer text is otherwise a
/// channel through which one customer could learn another holds a document
/// containing an exact passage. These are Internal-Use documents held by us as
/// a vendor, and the hit rate lost to tenant isolation is not worth that.
///
/// `kind` is here so the same table takes figure descriptions, chunk preambles
/// and clause verdicts later without a migration. Only embeddings use it today,
/// and only embeddings are risk-free — a verdict depends on the submitted
/// design as well as the standard, and reusing one has to be recorded on the
/// finding or the audit trail starts lying.
/// One company's own model key.
///
/// Per organisation, and generation only — judging clauses, reading a
/// standard's rules, describing a figure, writing a chunk preamble, suggesting
/// improvements. Embeddings are deliberately *not* covered: a vector is only
/// comparable with vectors from the same model, the corpus is indexed by model
/// name, and a company that switched embedding model would silently lose dense
/// retrieval over everything they had already ingested. See the note in
/// src/lib/ingest/retrieval.ts.
///
/// Absent is the normal state. An organisation with no row here is served by
/// the deployment's own key from the environment, which is what every
/// organisation did before this table existed.
///
/// The key itself is never stored in the clear and never leaves the server: the
/// UI is shown `keyLast4` and nothing else, and the Python workers read it
/// through /api/internal/credentials rather than holding a copy — the same
/// arrangement, and the same reasoning, as the UploadThing token in
/// src/lib/ingest/storage.ts.
model ProviderCredential {
  id String @id @default(cuid())

  /// Unique: one live key per company. A second row would mean two answers to
  /// "which model judged this", decided by whichever the query happened to
  /// return first.
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// "openrouter" | "anthropic" | "gemini" — the three clients
  /// Workers/aidp/ai/llm.py implements. Not free text: a provider nothing can
  /// talk to would be accepted here and fail on every job afterwards.
  provider String

  /// AES-256-GCM, base64, with the organisation id as additional authenticated
  /// data — so a ciphertext copied to another company's row fails to decrypt
  /// rather than quietly working. See src/lib/access/secrets.ts.
  ciphertext String

  /// The last four characters, which is all any screen ever shows. Enough to
  /// confirm which key is installed without being enough to use it.
  keyLast4 String

  /// Everything a verdict rests on. Strict JSON replies and vision.
  model String
  /// The high-volume call — one contextual preamble per chunk.
  fastModel String

  /// OpenRouter only: upstreams a request may be served by. Empty means
  /// OpenRouter's own routing. Pinning is what keeps client documents off a
  /// host the customer has not agreed to.
  openrouterProviders String[] @default([])
  /// OpenRouter only: demand zero-data-retention endpoints. Off by default
  /// because not every model has one.
  zdr Boolean @default(false)

  /// False when the handshake below found the key unable to do the work. The
  /// row is kept rather than discarded so the administrator can see what was
  /// wrong with what they pasted, and the workers skip an inactive key exactly
  /// as if it were absent.
  ///
  /// The probe's verdict, never the administrator's choice — that is `enabled`.
  /// Two fields rather than one because the screen has to tell "your key is
  /// broken" from "you asked for the platform's", and a single flag would make
  /// a deliberately parked key look like a failed one.
  active Boolean @default(true)

  /// The administrator's own switch: off means use the deployment's key, and
  /// keep this one.
  ///
  /// Trying a key and going back used to mean deleting it, so going back again
  /// meant finding and pasting the key a second time. The row survives being
  /// switched off — ciphertext, model, pinned hosts and all — so the two states
  /// are one click apart in both directions.
  ///
  /// To a worker this is indistinguishable from having no key at all, which is
  /// the behaviour every organisation had before any of this existed. See
  /// `resolve` in src/lib/access/credentials.ts.
  enabled Boolean @default(true)

  /// What the key could do when it was last tested: authentication, strict JSON
  /// replies, vision. Stored because a key that authenticates but cannot return
  /// a JSON object breaks assessments one clause at a time — caught by the
  /// per-clause guard, which is to say silently. Far better to find out while
  /// somebody is looking at the screen that saved it.
  probe    Json?
  probedAt DateTime?

  /// Who installed it. Null once that account is deleted; the key is the
  /// company's, not theirs, and must not leave with them.
  setById String?
  setBy   User?  @relation(fields: [setById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("provider_credential")
}

model AiCache {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// "embedding" today. "figure" | "preamble" | "verdict" later.
  kind String

  /// sha256 over every input the answer depends on, including the model name —
  /// so the day a provider retires a model, every entry it produced stops
  /// matching instead of being served from under the new one.
  fingerprint String

  /// Denormalised out of the fingerprint for diagnostics: the hash cannot be
  /// read, and "which model produced this row" is the first question asked of a
  /// cache that looks wrong.
  model String

  /// Embeddings live in a pgvector column rather than JSON: 1024 floats are 4KB
  /// here and roughly 20KB as JSON text, and this table grows per distinct
  /// passage per customer.
  vector Unsupported("vector(1024)")?

  /// Everything that is not a vector — a figure description, a verdict object.
  payload Json?

  /// What this answer cost to produce the first time. Kept so the saving is
  /// reportable: hits multiplied by this is the bill that was never sent.
  costTokens Int @default(0)

  /// Reuse count and recency, for reporting and for evicting what nobody wants.
  hits       Int      @default(0)
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([organisationId, kind, fingerprint])
  @@index([organisationId, lastUsedAt])
  @@map("ai_cache")
}
