# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated Prisma client (recreated by `npm run db:generate`)
/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded documents and extracted figures (see STORAGE_LOCAL_PATH)
.storage/

# local screenshots and per-machine tool config
.shots/
.claude/settings.local.json
